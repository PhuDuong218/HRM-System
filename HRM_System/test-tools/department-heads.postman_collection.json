    {
      "name": "03 — Chuỗi ghi dữ liệu thử nghiệm (mặc định tắt)",
      "description": "Chỉ chạy trên phòng mới chưa có trưởng phòng. Phân công A/B phải bắt đầu trước firstDate. Chạy đúng thứ tự, đặt runMutations=true và token thật. Không tự rollback các thay đổi HTTP.",
      "item": [
        {
          "name": "01 Bổ nhiệm A",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/departments/{{departmentId}}/head",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeId\": {{employeeA}},\n  \"effectiveFrom\": \"{{firstDate}}\",\n  \"reason\": \"Kiểm thử bổ nhiệm A\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.variables.get('runMutations') !== 'true' || !pm.variables.get('token')) {",
                  "  pm.execution.skipRequest();",
                  "} else {",
                  "  ['departmentId','employeeA','employeeB','nextPositionId'].forEach(function(k) {",
                  "    if (!/^[1-9][0-9]*$/.test(pm.variables.get(k) || '')) { pm.execution.skipRequest(); throw new Error('Set a positive test ID for ' + k); }",
                  "  });",
                  "  var dates = ['firstDate','replaceDate','endDate'].map(function(k) {",
                  "    var v=pm.variables.get(k) || '';",
                  "    if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(v) || Number.isNaN(Date.parse(v))) { pm.execution.skipRequest(); throw new Error('Set a valid YYYY-MM-DD date for ' + k); }",
                  "    return v;",
                  "  });",
                  "  var today = new Date(Date.now()+7*60*60*1000).toISOString().slice(0,10);",
                  "  if (!(dates[0] < dates[1] && dates[1] < dates[2] && dates[2] <= today)) {",
                  "    pm.execution.skipRequest(); throw new Error('Require firstDate < replaceDate < endDate <= today in Vietnam.');",
                  "  }",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Người mới là A', function () { pm.expect(pm.response.json().employeeId).to.eql(Number(pm.variables.get('employeeA'))); });"
                ]
              }
            }
          ]
        },
