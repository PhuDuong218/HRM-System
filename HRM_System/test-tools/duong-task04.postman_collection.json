    {
      "name": "D - Nhiệm vụ 6 - API hồ sơ cá nhân",
      "description": "Nhập tokenPersonalA và tokenPersonalB cho hai tài khoản đang hoạt động gắn hai nhân viên khác nhau. Chọn contractAId thuộc A và contractBId thuộc B. employeeBId dùng để thử giả mạo bộ lọc. Toàn bộ request dùng GET.",
      "item": [
        {
          "name": "A đọc danh sách hợp đồng, thử gửi employeeId của B",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/me/contracts?page=0&size=10&employeeId={{employeeBId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "type": "string",
                  "value": "{{tokenPersonalA}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
                  "pm.test(\"Phân trang đúng định dạng\",()=>{const page=pm.response.json();pm.expect(page.items).to.be.an(\"array\");pm.expect(page.page).to.eql(0);});",
                  "pm.test(\"Không có hợp đồng của B\",()=>{const id=String(pm.variables.get(\"contractBId\"));pm.expect(pm.response.json().items.map(r=>String(r.contractId))).not.to.include(id);});"
                ]
              }
            }
          ]
        },
        {
          "name": "A đọc hợp đồng và mức lương của mình",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/me/contracts/{{contractAId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "type": "string",
                  "value": "{{tokenPersonalA}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
                  "pm.test(\"Hợp đồng A và mức lương cá nhân\",()=>{const d=pm.response.json();pm.expect(String(d.contract.contractId)).to.eql(String(pm.variables.get(\"contractAId\")));pm.expect(d.salaryTerms).to.be.an(\"array\");for(const t of d.salaryTerms){pm.expect(t).not.to.have.property(\"documentReference\");}});"
                ]
              }
            }
          ]
        },
        {
          "name": "B đọc hợp đồng B",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/me/contracts/{{contractBId}}",
            "auth": {
              "type": "bearer",
