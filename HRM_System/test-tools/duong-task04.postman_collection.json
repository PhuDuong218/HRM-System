      "name": "A - Thành công (token ADMIN hoặc HR)",
      "item": [
        {
          "name": "Sắp hết hạn mặc định 30 ngày",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/contracts/expiring"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
                  "const d=pm.response.json();",
                  "pm.test(\"PageResponse\",()=>{pm.expect(d.items).to.be.an(\"array\");pm.expect(d.page).to.be.a(\"number\");pm.expect(d.size).to.be.within(1,100);pm.expect(d.totalElements).to.be.at.least(0);pm.expect(d.items.length).to.be.at.most(d.size);});",
                  "pm.test(\"Sắp hết hạn đúng khoảng, sắp xếp ổn định\",()=>{let previous=null;for(const r of d.items){pm.expect(r.contractId).to.be.a(\"number\");pm.expect(r.employeeCode).to.be.a(\"string\");pm.expect(r.employeeName).to.be.a(\"string\");pm.expect(r.daysLeft).to.be.within(0,30);if(previous){pm.expect(r.endDate>=previous.endDate).to.eql(true);if(r.endDate===previous.endDate)pm.expect(r.contractId).to.be.greaterThan(previous.contractId);}previous=r;}});"
                ]
              }
            }
          ]
        },
        {
