                  "pm.test(\"Ngưỡng 30 ngày và dữ liệu không tự suy đoán\",()=>{for(const r of d.items){if(r.lastContractEndDate===null){pm.expect(r.overdueDays).to.eql(null);pm.expect(r.overdueOver30).to.eql(false);}else{pm.expect(r.overdueDays).to.be.greaterThan(0);pm.expect(r.overdueOver30).to.eql(r.overdueDays>30);}pm.expect(r).to.have.property(\"nextContractStart\");}});"
                ]
