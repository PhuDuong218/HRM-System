<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F4F7FC">
 <LinearLayout android:id="@+id/employeeHeader" android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:background="#FFFFFF">
  <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="H" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="22sp" android:background="@drawable/hrm_brand" />
  <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HRM Center" android:textSize="18sp" android:textStyle="bold" android:textColor="#163D5C" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ỨNG DỤNG NHÂN VIÊN" android:textSize="10sp" android:textColor="#6D8196" /></LinearLayout>
  <com.google.android.material.button.MaterialButton android:id="@+id/employeeRefresh" style="@style/Widget.Material3.Button.TextButton" android:layout_width="64dp" android:layout_height="48dp" android:text="Tải lại" android:textColor="#004581" android:textSize="12sp" android:padding="0dp" android:insetLeft="0dp" android:insetRight="0dp" />
 </LinearLayout>
 <ProgressBar android:id="@+id/employeeLoading" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:indeterminate="true" android:visibility="gone" />
 <androidx.core.widget.NestedScrollView android:id="@+id/employeeScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true"><LinearLayout android:id="@+id/employeeBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" /></androidx.core.widget.NestedScrollView>
 <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/employeeNavigation" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#FFFFFF" app:menu="@menu/employee_navigation" app:labelVisibilityMode="labeled" app:itemIconTint="@color/employee_nav_color" app:itemTextColor="@color/employee_nav_color" app:itemActiveIndicatorStyle="@style/HrmNavigationIndicator" />
</LinearLayout>
